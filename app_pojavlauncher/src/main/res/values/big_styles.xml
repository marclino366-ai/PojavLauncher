<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BigBtn" parent="android:Widget.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/big_btn_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="BigBtnPrimary" parent="BigBtn">
        <item name="android:background">@drawable/big_btn_primary_bg</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
